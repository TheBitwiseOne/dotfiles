compress() {

  # -----------------------------------------------------------------------------
  # compress - Create a .tar.gz archive from a file or directory for SSH transfer
  #
  # USAGE:
  #   tarsend /path/to/file_or_dir
  #
  # ARGUMENTS:
  #   $1 - Path to the file or directory to compress
  #
  # DESCRIPTION:
  #   - Creates a compressed .tar.gz archive of the specified file or directory.
  #   - The archive is named using the base name of the target (e.g., myfolder.tar.gz).
  #   - Useful for preparing files to transfer over SSH.
  #
  # EXAMPLE:
  #   tarsend ~/projects/myapp
  #   # Produces myapp.tar.gz in the current directory
  #
  # TO SEND OVER SSH:
  #   rsync -avz myapp.tar.gz user@host:/remote/path/
  # -----------------------------------------------------------------------------

  local SRC="$1"

  if [[ -z "$SRC" ]]; then
    echo "Usage: tarsend /path/to/file_or_directory"
    return 1
  fi

  if [[ ! -e "$SRC" ]]; then
    echo "Error: '$SRC' does not exist"
    return 1
  fi

  local BASENAME
  BASENAME="$(basename "$SRC")"
  local ARCHIVE="${BASENAME}.tar.gz"

  echo "📦 Creating archive: $ARCHIVE"
  tar -czf "$ARCHIVE" -C "$(dirname "$SRC")" "$BASENAME"

  echo "✅ Archive created: $ARCHIVE"
  echo "➡️  To send via SSH:"
  echo "   rsync -avz $ARCHIVE user@host:/remote/path/"
}

dev_services_start() {

  # -----------------------------------------------------------------------------
  # dev_services_start - Start Docker and Ollama development services
  #
  # USAGE:
  #   dev_services_start
  #
  # DESCRIPTION:
  #   - Starts containerd, the Docker socket, the Docker daemon, and Ollama.
  #   - Does not enable any of these services at boot.
  #   - May restore containers configured with an automatic restart policy.
  # -----------------------------------------------------------------------------

  sudo systemctl start \
    containerd.service \
    docker.socket \
    docker.service \
    ollama.service
}

dev_services_stop() {

  # -----------------------------------------------------------------------------
  # dev_services_stop - Stop and disable Docker and Ollama services
  #
  # USAGE:
  #   dev_services_stop
  #
  # DESCRIPTION:
  #   - Stops Docker, its supporting services, and Ollama.
  #   - Disables all associated units to prevent startup at boot.
  #   - Run `npx supabase stop` first when local Supabase is active.
  # -----------------------------------------------------------------------------

  sudo systemctl disable --now \
    docker.service \
    docker.socket \
    containerd.service \
    ollama.service
}

docker_start() {

  # -----------------------------------------------------------------------------
  # docker_start - Start Docker and its supporting services
  #
  # USAGE:
  #   docker_start
  #
  # DESCRIPTION:
  #   - Starts containerd, the Docker socket, and the Docker daemon.
  #   - Does not enable these services at boot.
  #   - May restore containers configured with an automatic restart policy.
  # -----------------------------------------------------------------------------

  sudo systemctl start \
    containerd.service \
    docker.socket \
    docker.service
}

docker_stop() {

  # -----------------------------------------------------------------------------
  # docker_stop - Stop and disable Docker and its supporting services
  #
  # USAGE:
  #   docker_stop
  #
  # DESCRIPTION:
  #   - Stops the Docker daemon, Docker socket, and containerd.
  #   - Disables all three units to prevent automatic startup at boot.
  #   - Run `npx supabase stop` first when local Supabase is active.
  # -----------------------------------------------------------------------------

  sudo systemctl disable --now \
    docker.service \
    docker.socket \
    containerd.service
}

extract() {

  # -----------------------------------------------------------------------------
  # extract - Extract compressed archive files based on file extension
  #
  # USAGE:
  #   extract <archive_file>
  #
  # ARGUMENTS:
  #   $1 - The compressed archive file to extract
  #
  # DESCRIPTION:
  #   - Supports common formats like .tar.gz, .zip, .rar, .7z, etc.
  #   - Automatically chooses the correct extraction tool based on extension.
  #   - Shows an error message if the format is unsupported or file is missing.
  # -----------------------------------------------------------------------------

  if [ -f "$1" ]; then
    case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz) tar xzf "$1" ;;
    *.tar.xz) tar xJf "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *.rar) unrar x "$1" ;;
    *.gz) gunzip "$1" ;;
    *.tar) tar xf "$1" ;;
    *.tbz2) tar xjf "$1" ;;
    *.tgz) tar xzf "$1" ;;
    *.zip) unzip "$1" ;;
    *.7z) 7z x "$1" ;;
    *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi

}

hunt() {

  # -----------------------------------------------------------------------------
  # s - Search for package remnants
  #
  # USAGE:
  #   s <name>
  #
  # DESCRIPTION:
  #   - Searches common locations for files and directories matching a name.
  #   - Intended for finding leftovers after uninstalling software.
  #   - Case-insensitive.
  # -----------------------------------------------------------------------------

  if [[ $# -ne 1 ]]; then
    echo "Usage: hunt <name>"
    return 1
  fi

  sudo find \
    /etc \
    /usr \
    /opt \
    /var \
    /home \
    -iname "*$1*" \
    2>/dev/null
}

ollama_start() {

  # -----------------------------------------------------------------------------
  # ollama_start - Start the Ollama service
  #
  # USAGE:
  #   ollama_start
  #
  # DESCRIPTION:
  #   - Starts the Ollama service for the current session.
  #   - Does not enable Ollama at boot.
  # -----------------------------------------------------------------------------

  sudo systemctl start ollama.service
}

ollama_stop() {

  # -----------------------------------------------------------------------------
  # ollama_stop - Stop and disable the Ollama service
  #
  # USAGE:
  #   ollama_stop
  #
  # DESCRIPTION:
  #   - Stops the Ollama service.
  #   - Disables Ollama to prevent automatic startup at boot.
  # -----------------------------------------------------------------------------

  sudo systemctl disable --now ollama.service
}

writeiso() {

  # -----------------------------------------------------------------------------
  # writeiso - Safely write a bootable ISO to a USB device using dd
  #
  # USAGE:
  #   writeiso /path/to/file.iso /dev/sdX
  #
  # ARGUMENTS:
  #   $1 - Path to the ISO file (e.g., ~/Downloads/archlinux-*.iso)
  #   $2 - Target device (e.g., /dev/sdb — not a partition like /dev/sdb1)
  #
  # DESCRIPTION:
  #   - Automatically unmounts all mounted partitions on the target device.
  #   - Uses dd with optimal options for performance and safety.
  #   - Displays progress and syncs writes to reduce corruption risk.
  #
  # HOW TO FIND YOUR USB DEVICE:
  #   Run: lsblk
  #   Look for your USB stick based on size and name.
  #   Example output:
  #     sdb      8:16   1   7.5G  0 disk
  #     └─sdb1   8:17   1   7.5G  0 part /run/media/clinton/ARCH_*
  #   In this case, the correct target is /dev/sdb
  # -----------------------------------------------------------------------------

  local ISO="$1"
  local TARGET="$2"

  if [[ -z "$ISO" || -z "$TARGET" ]]; then
    echo "Usage: writeiso /path/to/iso /dev/sdX"
    return 1
  fi

  if [[ ! -f "$ISO" ]]; then
    echo "Error: ISO file not found at $ISO"
    return 1
  fi

  if [[ ! -b "$TARGET" ]]; then
    echo "Error: Target $TARGET is not a block device"
    return 1
  fi

  echo "🔍 Unmounting partitions on $TARGET..."
  for part in $(lsblk -ln "$TARGET" | awk '{print $1}'); do
    sudo umount "/dev/$part" 2>/dev/null
  done

  echo "⚠️ Writing $ISO to $TARGET with dd..."
  sudo dd bs=4M if="$ISO" of="$TARGET" status=progress oflag=sync

  echo "✅ Done. You may now eject the device:"
  echo "   sudo eject $TARGET"
}

y() {

  # -----------------------------------------------------------------------------
  # y - Launch yazi file manager and change shell directory on exit
  #
  # USAGE:
  #   y [<yazi_args>...]
  #
  # DESCRIPTION:
  #   - Launches yazi file manager.
  #   - Captures the final working directory from yazi.
  #   - Changes the shell’s current directory to match yazi’s on exit.
  #   - Uses a temporary file to store the working directory path.
  # -----------------------------------------------------------------------------

  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

